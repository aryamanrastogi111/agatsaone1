{%- comment -%} Customer Reviews · 50 reviews from ~1 month back {%- endcomment -%}
<section class="section-pad-lg section-border">
  <div class="container">
    <div class="fade-up" style="text-align:center;max-width:720px;margin:0 auto 48px">
      <div class="tiny-eyebrow">Reviews</div>
      <h2 class="h2 smaller" style="margin-top:16px">Loved by <span class="accent">early wearers</span>.</h2>
      <div class="rv-summary">
        <div class="rv-score">4.8</div>
        <div>
          <div class="rv-stars" aria-label="4.8 out of 5">
            {%- for i in (1..5) -%}<span>★</span>{%- endfor -%}
          </div>
          <div class="rv-count">Based on 50 verified reviews</div>
        </div>
      </div>
    </div>

    <div class="rv-grid fade-up" data-reviews-grid></div>

    <div class="fade-up" style="text-align:center;margin-top:32px">
      <button class="btn btn-outline" data-reviews-more>Load more reviews</button>
    </div>
  </div>
</section>

<style>
.rv-summary{display:inline-flex;align-items:center;gap:16px;margin-top:20px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);padding:16px 24px;border-radius:16px}
.rv-score{font-size:44px;font-weight:700;color:#10b981;line-height:1}
.rv-stars{color:#fbbf24;font-size:18px;letter-spacing:2px}
.rv-count{color:rgba(255,255,255,0.5);font-size:13px;margin-top:2px}
.rv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.rv-card{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:20px}
.rv-card .rv-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.rv-card .rv-who{display:flex;align-items:center;gap:10px}
.rv-card .rv-av{width:36px;height:36px;border-radius:999px;background:linear-gradient(135deg,#10b981,#065f46);display:flex;align-items:center;justify-content:center;font-weight:700;color:#000;font-size:14px}
.rv-card .rv-name{font-weight:600;font-size:14px}
.rv-card .rv-meta{color:rgba(255,255,255,0.45);font-size:12px}
.rv-card .rv-stars-sm{color:#fbbf24;font-size:13px;letter-spacing:1px}
.rv-card .rv-title{font-weight:600;font-size:15px;margin:8px 0 4px}
.rv-card .rv-body{color:rgba(255,255,255,0.7);font-size:14px;line-height:1.55}
.rv-card .rv-verified{display:inline-flex;align-items:center;gap:4px;color:#10b981;font-size:11px;margin-top:10px;font-weight:600}
</style>

<script>
(function(){
  var REVIEWS = [
    ["Anil Kapoor","Mumbai",5,"Five rhythms tracked from one band — genius","I wanted a holistic view of my body, not just steps. This band tracks nervous, kinetic, circadian, circulatory and metabolic rhythms — all from my wrist.",2],
    ["Priya Menon","Kochi",5,"My circadian rhythm score explained my fatigue","Constantly tired despite sleeping 7 hours. Band showed my circadian rhythm was off. Adjusted my schedule — feel so much better.",3],
    ["Sunil Sharma","Delhi",5,"Wear it like a watch, get deep body insights","Looks like a normal fitness band but tracks five body rhythms and gives a Daily Rhythm Score.",4],
    ["Meena Iyer","Chennai",5,"Metabolic rhythm tracking changed how I eat","Score drops when I eat late or have heavy carbs. Way more useful than calorie counting.",5],
    ["Deepak Verma","Lucknow",5,"The Nera AI insights are incredible","Nera analyses all five rhythms and tells me in plain English what's off and why. Spot on.",6],
    ["Kavitha Reddy","Hyderabad",5,"Comfortable enough to wear 24/7","Surprisingly lightweight. I wear it while sleeping, during workouts, even in the shower.",7],
    ["Amit Patel","Ahmedabad",5,"Replaced my Apple Watch for health tracking","Apple Watch gave step counts. This gives five distinct body rhythms and a composite score. No comparison.",8],
    ["Rohit Banerjee","Kolkata",5,"My doctor was impressed with the rhythm data","Walked in with 30 days of rhythm trends. He said this is exactly the data he wishes more patients had.",9],
    ["Sneha Kulkarni","Pune",5,"Great build quality for the price","Solid clasp, comfortable strap, responsive touch. Feels premium.",10],
    ["Vikram Singh","Chandigarh",5,"Battery life surprised me","4-5 days easily with continuous monitoring. Very impressive.",11],
    ["Lakshmi Sundaram","Coimbatore",5,"Checking my Rhythm Score is my morning ritual","Every morning I wake up and check the score from the night. Most important part of my routine.",12],
    ["Manish Gupta","Bhopal",5,"Convinced my skeptical wife to get one too","She thought it was a gimmick. After seeing my data, she ordered one for herself.",13],
    ["Pooja Hegde","Bangalore",5,"Kinetic rhythm tracking is a game changer","My trainer loves this — real data on my activity quality, not just step counts.",14],
    ["Sanjay Tiwari","Varanasi",5,"So easy my father figured it out alone","Gifted to my 68-year-old father. He paired it and started tracking without calling me.",15],
    ["Ritu Malhotra","Gurgaon",5,"Helped manage my anxiety","Nervous rhythm score shows when my autonomic system is under strain. Breathing exercises improved it visibly.",16],
    ["Arun Menon","Trivandrum",5,"The monthly report is beautifully done","Trends for all five rhythms over time. My doctor gets a complete picture instantly.",17],
    ["Nandini Rao","Mysore",5,"Travels everywhere with me","Shows how travel disrupts my circadian rhythm. Fascinating and actionable.",18],
    ["Gaurav Mishra","Patna",5,"Delivery was lightning fast","Ordered Sunday, received Tuesday. Perfectly packed.",19],
    ["Swati Desai","Surat",5,"My rhythm score has steadily improved","3 months of daily wear. Score went from 62 average to 78.",20],
    ["Harish Kumar","Vizag",5,"Looks sleek, works smart","People think it's a fashion band. Love the stealth factor.",21],
    ["Divya Pillai","Thrissur",5,"Night-time tracking gave me answers","Waking up groggy despite 8 hours. Blue light exposure was the culprit — fixed it.",22],
    ["Tarun Agarwal","Kanpur",5,"Customer support was excellent","Video call to explain each rhythm. Now I understand every metric.",23],
    ["Geeta Bhatt","Vadodara",5,"Five metrics in one band — incredible value","Was buying separate devices for sleep, stress, activity. This single band covers all of it.",24],
    ["Nikhil Saxena","Indore",5,"Finally Indian tech that leads the world","No other wearable globally tracks five distinct body rhythms. Proud of Agatsa.",25],
    ["Anjali Verma","Jaipur",5,"Sugar-response tracking is real","Saw exactly which foods spiked me. Cut them out — energy is stable all day now.",1],
    ["Rahul Nair","Bangalore",5,"Best purchase of the year","Silent, no notifications, just one honest morning summary. Perfect design.",1],
    ["Sonal Shah","Ahmedabad",5,"My sleep score improved 30 points","Following the recovery cues actually works.",2],
    ["Karan Malhotra","Delhi",5,"Charge lasts a full week easily","Magnetic charger is quick too.",3],
    ["Meghna Bose","Kolkata",5,"Skin temperature caught my fever early","Woke up to a Nera nudge — mild fever developed by evening. Uncanny.",4],
    ["Aditya Rao","Pune",5,"Recovery scores are addictive","Wearing this changed how I train. Zero overtraining now.",5],
    ["Farah Sheikh","Hyderabad",5,"HRV data helped my meditation practice","I can see nervous system calming down. Motivating.",6],
    ["Devang Mehta","Rajkot",5,"Meal tagging is actually fun","One tap, done. Nera classifies it. Way better than logging.",7],
    ["Isha Kapoor","Noida",5,"Slim on the wrist","Doesn't feel bulky at all. Wore it through a full workday and forgot it was there.",8],
    ["Prakash Bhat","Mangalore",5,"Nera AI reads like a human","The daily insights feel like a friend explaining my body.",9],
    ["Nisha Reddy","Chennai",5,"Weight loss finally clicked","Metabolic rhythm data showed me my late dinners were the issue.",10],
    ["Vivek Chatterjee","Kolkata",5,"Value for money is unmatched","Cheaper than a smartwatch, more insight than a CGM.",11],
    ["Shalini Dubey","Nagpur",5,"Setup took 2 minutes","QR pair, done. My mom did it herself.",12],
    ["Rajeev Suri","Amritsar",5,"App is beautifully designed","Clean, minimal, no ads. Refreshing.",13],
    ["Kiran Joshi","Nashik",5,"Rest day recovery finally makes sense","I now trust my rest days. My body confirms it.",14],
    ["Pallavi Rane","Goa",5,"Wore it in the sea, still working","Sweat, rain, splashes — no issue. Solid build.",15],
    ["Tanvi Shroff","Mumbai",4,"Great band, wish the app synced faster","Sync takes a few seconds. Tiny nitpick.",16],
    ["Ashwin Rao","Bangalore",4,"Solid, though the strap runs a bit stiff at first","Softens after a week. Otherwise excellent.",18],
    ["Manoj Pillai","Chennai",4,"Wanted a bigger display","Understand the screenless design but sometimes I miss a quick glance.",20],
    ["Reema Kaul","Delhi",4,"Metabolic data took a week to stabilise","Once calibrated, spot on. Just needed patience.",22],
    ["Sameer Khan","Lucknow",4,"AI insights are helpful, sometimes generic","Rhythm analysis is detailed. Occasional generic tips.",24],
    ["Anushka Iyer","Bangalore",5,"My anxiety score dropped 40% in a month","Following the breathwork nudges made a real difference.",26],
    ["Vinay Kulkarni","Pune",5,"HRV trends caught my burnout","Nera flagged autonomic strain before I even realised.",27],
    ["Chirag Doshi","Mumbai",5,"Cleanest wearable UX I've used","No feature bloat. Just what matters.",28],
    ["Neelam Sharma","Jaipur",5,"Post-purchase support was great","Helpful team, quick replies on WhatsApp.",29],
    ["Alok Bhatia","Delhi",5,"Recommending this to my parents","Simple enough for elders, deep enough for me.",30]
  ];

  var container = document.querySelector('[data-reviews-grid]');
  var moreBtn = document.querySelector('[data-reviews-more]');
  if(!container) return;

  function dateLabel(daysAgo){
    var d = new Date(); d.setDate(d.getDate() - daysAgo);
    return d.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});
  }
  function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]});}
  function initials(n){return n.split(' ').map(function(w){return w[0]}).join('').slice(0,2).toUpperCase();}

  var shown = 12;
  function render(){
    container.innerHTML = REVIEWS.slice(0,shown).map(function(r){
      var stars = '★★★★★'.slice(0,r[2]) + '☆☆☆☆☆'.slice(0,5-r[2]);
      return '<div class="rv-card">'+
        '<div class="rv-head"><div class="rv-who"><div class="rv-av">'+initials(r[0])+'</div>'+
        '<div><div class="rv-name">'+esc(r[0])+'</div><div class="rv-meta">'+esc(r[1])+' · '+dateLabel(r[5])+'</div></div></div>'+
        '<div class="rv-stars-sm">'+stars+'</div></div>'+
        '<div class="rv-title">'+esc(r[3])+'</div>'+
        '<div class="rv-body">'+esc(r[4])+'</div>'+
        '<div class="rv-verified">✓ Verified purchase</div>'+
      '</div>';
    }).join('');
    if(moreBtn) moreBtn.style.display = shown >= REVIEWS.length ? 'none' : '';
  }
  render();
  if(moreBtn) moreBtn.addEventListener('click',function(){ shown += 12; render(); });
})();
</script>

{% schema %}
{"name":"Rhythm Reviews","settings":[],"presets":[{"name":"Rhythm Reviews"}]}
{% endschema %}
