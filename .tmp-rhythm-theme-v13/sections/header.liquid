{% comment %} Header {% endcomment %}
<header class="site-header">
  <div class="inner">
    <a href="{{ routes.root_url }}" class="logo">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 220 }}" alt="{{ shop.name | escape }}" style="max-height:32px;width:auto">
      {%- else -%}
        {{ section.settings.brand_name | default: 'Rhythm' }}<span class="dot">.</span>
      {%- endif -%}
    </a>
    <nav>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      {%- elsif linklists.main-menu.links.size > 0 -%}
        {%- for link in linklists.main-menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header-cart">Cart <span class="badge" data-cart-count {% if cart.item_count == 0 %}style="display:none"{% endif %}>{{ cart.item_count }}</span></a>
    </nav>
  </div>
</header>
{% schema %}
{
  "name":"Header",
  "settings":[
    {"type":"text","id":"brand_name","label":"Brand name","default":"Rhythm"},
    {"type":"image_picker","id":"logo","label":"Logo"}
  ],
  "blocks":[{"type":"link","name":"Navigation link","settings":[
    {"type":"text","id":"label","label":"Label","default":"Rhythm Band"},
    {"type":"url","id":"link","label":"Link"}
  ]}],
  "presets":[{"name":"Header","blocks":[{"type":"link","settings":{"label":"Rhythm Band","link":"/"}},{"type":"link","settings":{"label":"FAQ","link":"#shopify-section-template--rhythm_faq"}}]}]
}
{% endschema %}
