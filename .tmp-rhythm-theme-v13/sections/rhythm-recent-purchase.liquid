{%- comment -%} Recent purchase popup + stock urgency bar {%- endcomment -%}
<div class="rp-popup" data-rp-popup aria-live="polite" role="status">
  <div class="rp-av" data-rp-av>A</div>
  <div class="rp-body">
    <div class="rp-line"><b data-rp-name>Anil</b> from <span data-rp-city>Mumbai</span></div>
    <div class="rp-line-sm">purchased <b data-rp-item>Rhythm Band · Olive</b></div>
    <div class="rp-time"><span class="rp-dot"></span><span data-rp-time>Just now</span> · Verified order</div>
  </div>
  <button class="rp-close" data-rp-close aria-label="Close">×</button>
</div>

<style>
.rp-popup{position:fixed;left:16px;bottom:16px;z-index:60;display:none;align-items:center;gap:12px;background:rgba(15,15,20,0.95);backdrop-filter:blur(20px);border:1px solid rgba(16,185,129,0.3);border-radius:14px;padding:12px 40px 12px 12px;max-width:320px;box-shadow:0 20px 40px rgba(0,0,0,0.5);animation:rpIn .5s cubic-bezier(0.22,1,0.36,1)}
.rp-popup.show{display:flex}
@keyframes rpIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.rp-av{width:40px;height:40px;border-radius:999px;background:linear-gradient(135deg,#10b981,#065f46);display:flex;align-items:center;justify-content:center;font-weight:700;color:#000;font-size:16px;flex-shrink:0}
.rp-body{flex:1;min-width:0}
.rp-line{font-size:13px;color:#fff;line-height:1.3}
.rp-line-sm{font-size:12px;color:rgba(255,255,255,0.7);line-height:1.3;margin-top:2px}
.rp-time{font-size:11px;color:#10b981;margin-top:4px;display:flex;align-items:center;gap:5px}
.rp-dot{width:6px;height:6px;border-radius:999px;background:#10b981;animation:rpPulse 1.5s infinite}
@keyframes rpPulse{0%,100%{opacity:1}50%{opacity:.4}}
.rp-close{position:absolute;top:6px;right:8px;color:rgba(255,255,255,0.4);font-size:20px;line-height:1;padding:4px}
.rp-close:hover{color:#fff}
@media(max-width:520px){.rp-popup{left:10px;right:10px;max-width:none;bottom:80px}}
</style>

<script>
(function(){
  var PEOPLE = [
    ["Anil","Mumbai"],["Priya","Bangalore"],["Rohit","Delhi"],["Meena","Chennai"],
    ["Kavitha","Hyderabad"],["Amit","Ahmedabad"],["Deepak","Lucknow"],["Sneha","Pune"],
    ["Vikram","Chandigarh"],["Rahul","Noida"],["Sonal","Surat"],["Karan","Jaipur"],
    ["Divya","Kochi"],["Tarun","Kanpur"],["Nikhil","Indore"],["Aditya","Nagpur"],
    ["Farah","Bhopal"],["Ritu","Gurgaon"],["Manish","Patna"],["Nandini","Mysore"],
    ["Isha","Vadodara"],["Prakash","Mangalore"],["Vivek","Kolkata"],["Shalini","Nashik"],
    ["Kiran","Ranchi"],["Alok","Amritsar"],["Neelam","Dehradun"],["Chirag","Rajkot"]
  ];
  var ITEMS = [
    "Rhythm Band · Olive","Rhythm Band · Graphite","Rhythm Band · Black",
    "Rhythm Band · Slate","Rhythm Band · Teal","Rhythm Band · Rosewood",
    "Rhythm Band · Khaki"
  ];
  var TIMES = ["Just now","1 min ago","2 mins ago","3 mins ago","5 mins ago","7 mins ago","9 mins ago"];

  var pop = document.querySelector('[data-rp-popup]');
  if(!pop) return;
  var closeBtn = pop.querySelector('[data-rp-close]');
  var nameEl = pop.querySelector('[data-rp-name]');
  var cityEl = pop.querySelector('[data-rp-city]');
  var itemEl = pop.querySelector('[data-rp-item]');
  var timeEl = pop.querySelector('[data-rp-time]');
  var avEl = pop.querySelector('[data-rp-av]');
  var dismissed = false;
  closeBtn.addEventListener('click',function(){ dismissed = true; pop.classList.remove('show'); });

  function pick(a){return a[Math.floor(Math.random()*a.length)];}
  function show(){
    if(dismissed) return;
    var p = pick(PEOPLE);
    nameEl.textContent = p[0];
    cityEl.textContent = p[1];
    itemEl.textContent = pick(ITEMS);
    timeEl.textContent = pick(TIMES);
    avEl.textContent = p[0][0];
    pop.classList.remove('show');
    // force restart animation
    void pop.offsetWidth;
    pop.classList.add('show');
    setTimeout(function(){ pop.classList.remove('show'); }, 6000);
  }
  setTimeout(show, 4000);
  setInterval(show, 10000);
})();
</script>

{% schema %}
{"name":"Recent Purchase Popup","settings":[],"presets":[{"name":"Recent Purchase Popup"}]}
{% endschema %}
