<section class="cart-page">
  <h1>{{ collection.title }}</h1>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px;margin-top:32px">
    {% for product in collection.products %}
      <a href="{{ product.url }}" style="display:block">
        <div style="aspect-ratio:1;background:rgba(255,255,255,0.05);border-radius:16px;overflow:hidden">
          {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" style="width:100%;height:100%;object-fit:cover">{% endif %}
        </div>
        <div style="margin-top:12px;font-weight:500">{{ product.title }}</div>
        <div style="color:rgba(255,255,255,0.6);font-size:14px;margin-top:4px">{{ product.price | money }}</div>
      </a>
    {% endfor %}
  </div>
</section>
