<section style="min-height:80vh;display:flex;align-items:center;justify-content:center;padding:40px 20px;text-align:center">
  <div style="max-width:520px">
    <h1 style="font-size:40px;font-weight:700;margin-bottom:12px">{{ shop.name }}</h1>
    <p style="color:rgba(255,255,255,0.7);margin-bottom:24px">Opening soon. Enter the store password to preview.</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Password" style="padding:12px 16px;border-radius:8px;border:1px solid rgba(255,255,255,0.2);background:transparent;color:#fff;width:100%;max-width:320px">
      <button type="submit" class="btn btn-emerald" style="margin-top:12px">Enter</button>
    {% endform %}
  </div>
</section>
