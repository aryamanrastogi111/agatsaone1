<div class="cart-page">
  {% if cart.item_count > 0 %}
    <h1>Your cart</h1>
    <form action="/cart" method="post" novalidate>
      {% for item in cart.items %}
        <div class="cart-line">
          <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}">
          <div class="info">
            <div class="t">{{ item.product.title }}</div>
            {% unless item.variant.title contains 'Default' %}<div class="v">{{ item.variant.title }}</div>{% endunless %}
            <div class="qty">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="quantity">
              <button type="submit" name="update" class="btn-outline" style="height:36px;padding:0 14px;border-radius:8px">Update</button>
            </div>
          </div>
          <div class="p">
            {{ item.final_line_price | money }}
            <a href="{{ item.url_to_remove }}">Remove</a>
          </div>
        </div>
      {% endfor %}
      <div class="cart-total">
        <span>Subtotal</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <button type="submit" name="checkout" class="btn btn-emerald btn-lg btn-block">Check out</button>
    </form>
  {% else %}
    <div class="cart-empty">
      <p>Your cart is empty.</p>
      <a href="/" class="btn btn-emerald" style="margin-top:24px">Continue shopping</a>
    </div>
  {% endif %}
</div>
